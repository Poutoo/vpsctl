{
  "name": "vpsctl",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run e2e:build && npm run e2e:run",
    "e2e:build": "node e2e/scripts/build.ts",
    "e2e:run": "wdio run e2e/wdio.conf.ts",
    "e2e:typecheck": "tsc -p e2e",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "bindings": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings",
    "icons": "node scripts/icons.js"
  },
  "dependencies": {
    "@tanstack/vue-virtual": "3.13.39",
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-opener": "2.7.0",
    "pinia": "4.0.3",
    "reka-ui": "2.10.5",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@wdio/cli": "10.1.0",
    "@wdio/globals": "10.1.0",
    "@wdio/local-runner": "10.1.0",
    "@wdio/mocha-framework": "10.1.0",
    "@wdio/spec-reporter": "10.1.0",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.1",
    "happy-dom": "20.14.5",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
