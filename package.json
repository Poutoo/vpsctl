{
  "name": "vpsctl",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "bindings": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings"
  },
  "dependencies": {
    "@tanstack/vue-virtual": "3.13.39",
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-opener": "2.7.0",
    "pinia": "4.0.3",
    "reka-ui": "2.10.5",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vue-tsc": "3.3.11"
  }
}
