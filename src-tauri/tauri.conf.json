{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlas",
  "mainBinaryName": "atlas-vps",
  "version": "1.1.0",
  "identifier": "dev.poutoo.atlas",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Atlas",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' blob:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "publisher": "Poutoo",
    "copyright": "© 2026 Poutoo",
    "category": "DeveloperTool",
    "shortDescription": "Contrôle d'un VPS Linux via SSH",
    "longDescription": "Explorateur de fichiers (SFTP), conteneurs Docker, services systemd utilisateur et scripts personnalisés d'un VPS Linux, par une seule connexion SSH.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["French"]
      }
    },
    "linux": {
      "deb": {
        "depends": ["libdbus-1-3"],
        "recommends": ["gnome-keyring | org.freedesktop.secrets"],
        "desktopTemplate": "linux/atlas-vps.desktop"
      }
    },
    "icon": [
      "icons/16x16.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
